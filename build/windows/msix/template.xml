<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="bdo-viewer.exe"
        Arguments=""
        InstallLocation="C:\Program Files\iDevelopThings\BDO Viewer">
    </Installer>
    <PackageInformation
        PackageName="BDO Viewer"
        PackageDisplayName="BDO Viewer"
        PublisherName="CN=iDevelopThings"
        PublisherDisplayName="iDevelopThings"
        Version="0.1.0.0"
        PackageDescription="A bdo-viewer application">
        <Capabilities>
            <Capability Name="runFullTrust" />

        </Capabilities>
        <Applications>
            <Application
                Id="com.idt.bdoviewer"
                Description="A bdo-viewer application"
                DisplayName="BDO Viewer"
                ExecutableName="bdo-viewer.exe"
                EntryPoint="Windows.FullTrustApplication">

            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>BDO Viewer</DisplayName>
            <PublisherDisplayName>iDevelopThings</PublisherDisplayName>
            <Description>A bdo-viewer application</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="bdo-viewer.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
